// ============================================
// SISTEMA DE CIERRE DE ENTRENAMIENTO (SURVEYS)
// ============================================

// Encuesta del Trainer al finalizar entrenamiento
model TrainerSurvey {
  id                Int      @id @default(autoincrement())
  productId         Int
  trainerId         Int
  
  // Valoraciones 1-5 estrellas
  salonAmbiente     Int      // 1-5
  instalaciones     Int      // 1-5
  staff             Int      // 1-5
  
  // Observaciones
  audioUrl          String?  // URL del audio grabado
  observaciones     String?  @db.Text
  
  createdAt         DateTime @default(now())
  
  Product           SchoolProduct @relation("TrainerSurveyProduct", fields: [productId], references: [id])
  Trainer           Usuario       @relation("TrainerSurveys", fields: [trainerId], references: [id])
  
  @@unique([productId, trainerId])
  @@index([productId])
  @@index([trainerId])
}

// Encuesta del Game Changer al finalizar entrenamiento
model GameChangerSurvey {
  id                  Int      @id @default(autoincrement())
  productId           Int
  gameChangerId       Int
  
  // Sección A: Instalaciones
  aireAcondicionado   String   // 'CONGELADO' | 'PERFECTO' | 'CALOR'
  limpiezaBanos       Int      // 0-100 slider
  coffeBreak          String   // 'A_TIEMPO' | 'TARDE_FALTANTE'
  
  // Sección B: Evaluación Humana
  entrenadorEstrellas Int      // 1-5
  entrenadorInspiro   Boolean  // Toggle Sí/No
  coordinadorRespaldo Int      // 0-100 slider (Abandonado a Totalmente apoyado)
  
  createdAt           DateTime @default(now())
  
  Product             SchoolProduct @relation("GCSurveyProduct", fields: [productId], references: [id])
  GameChanger         Usuario       @relation("GameChangerSurveys", fields: [gameChangerId], references: [id])
  
  @@unique([productId, gameChangerId])
  @@index([productId])
  @@index([gameChangerId])
}

// Estado de bloqueo del Game Changer
model GameChangerLockStatus {
  id              Int       @id @default(autoincrement())
  productId       Int
  gameChangerId   Int
  
  isLocked        Boolean   @default(true)
  unlockedAt      DateTime?
  surveyCompleted Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  Product         SchoolProduct @relation("GCLockProduct", fields: [productId], references: [id])
  GameChanger     Usuario       @relation("GameChangerLocks", fields: [gameChangerId], references: [id])
  
  @@unique([productId, gameChangerId])
  @@index([productId])
  @@index([gameChangerId])
}

// Auditoría del Director
model DirectorAudit {
  id                    Int      @id @default(autoincrement())
  productId             Int      @unique
  directorId            Int
  
  // Tarjeta 1: Momentos de Verdad (Toggles)
  auditRegistro         Boolean?
  auditRegistroNota     String?
  auditConcentracion    Boolean?
  auditConcentracionNota String?
  auditBreakLargo       Boolean?
  auditBreakLargoNota   String?
  auditEnrolamiento     Boolean?
  auditEnrolamientoNota String?
  auditSalaActiva       Boolean?
  auditSalaActivaNota   String?
  auditBreakCorto       Boolean?
  auditBreakCortoNota   String?
  
  // Tarjeta 2: Excelencia del Salón (3 estados: EXCELENTE, ACEPTABLE, FALLA)
  limpiezaGeneral       String?  // 'EXCELENTE' | 'ACEPTABLE' | 'FALLA'
  equipoSonido          String?
  visualesPantalla      String?
  materialesRotafolio   String?
  insumosBaul           String?
  cumplimientoTareas    String?
  mesaControl           String?
  
  // Tarjeta 3: Excelencia de Instalaciones
  climaAire             String?
  banosLimpieza         String?
  sillasEstado          String?
  pinturaParedes        String?
  brandingVinilos       String?
  
  // Tarjeta 4: Imagen Profesional (1-10 o 3 estados)
  liderazgoCapitanias   Int?     // 1-10
  disciplinaPuntualidad String?  // 3 estados
  imagenStaff           String?  // 3 estados
  imagenCoordinador     String?  // 3 estados
  contextoAlineamiento  String?  // 3 estados
  
  // Cierre
  observaciones         String?  @db.Text
  
  certifiedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  Product               SchoolProduct @relation("DirectorAuditProduct", fields: [productId], references: [id])
  Director              Usuario       @relation("DirectorAudits", fields: [directorId], references: [id])
  
  @@index([productId])
  @@index([directorId])
}

// ============================================
// BITÁCORA DE INICIO - Cuestionario Avanzado
// ============================================
model AdvancedQuestionnaire {
  id                     Int       @id @default(autoincrement())
  userId                 Int       @unique
  visionId               Int?
  
  // Estado del cuestionario
  status                 QuestionnaireStatus @default(NOT_STARTED)
  currentDimension       Int       @default(0)  // 0=welcome, 1-5=dimensions
  lastSavedAt            DateTime?
  completedAt            DateTime?
  
  // ===== DIMENSIÓN 1: RAÍCES Y RELACIONES =====
  // Estado Civil y Pareja
  maritalStatus          String?   // SINGLE, MARRIED, DIVORCED, WIDOWED, COMMON_LAW
  partnerRelationship    String?   @db.Text  // Descripción de la relación con pareja
  partnerRelationshipScore Int?    // 1-10
  
  // Hijos (JSON array: [{name, age, relationship}])
  hasChildren            Boolean?
  childrenData           Json?
  
  // Padres y Hermanos
  parentsRelationship    String?   @db.Text
  siblingsCount          Int?
  siblingsRelationship   String?   @db.Text
  
  // Red de apoyo
  hasCompanion           Boolean?  // ¿Alguien toma el entrenamiento contigo?
  companionName          String?
  companionRelation      String?
  
  // ===== DIMENSIÓN 2: CUERPO Y SOMBRA (Salud) =====
  healthStatus           String?   @db.Text  // Estado de salud actual
  currentMedications     String?   @db.Text  // Medicamentos
  isPregnant             Boolean?            // Solo para mujeres
  
  // ALERTA CRÍTICA
  hasSuicideAttempt      Boolean?
  suicideAttemptReason   String?   @db.Text
  
  // ===== DIMENSIÓN 3: LÍNEA DE VIDA =====
  // Niñez
  childhoodEvent         String?   @db.Text
  childhoodMeaning       String?   @db.Text
  
  // Adolescencia
  adolescenceEvent       String?   @db.Text
  adolescenceMeaning     String?   @db.Text
  
  // Adultez
  adulthoodEvent         String?   @db.Text
  adulthoodMeaning       String?   @db.Text
  
  // Impacto
  eventsInfluence        String?   @db.Text  // Cómo han influido en tu vida actual
  
  // ===== DIMENSIÓN 4: ESPEJOS Y CREENCIAS =====
  externalPerception     String?   @db.Text  // Cómo te describirían
  friendsPerception      String?   @db.Text  // ¿Tienes amigos? ¿Cómo te ven?
  religiousBeliefs       String?   @db.Text  // Costumbres religiosas
  educationBeliefs       String?   @db.Text  // Educación y creencias
  workDescription        String?   @db.Text  // Trabajo/carrera
  triggers               String?   @db.Text  // Detonantes/triggers
  
  // ===== DIMENSIÓN 5: EL PROPÓSITO =====
  lifePurpose            String?   @db.Text  // Propósito en el mundo
  
  // ===== FLAGS Y METADATA =====
  suicideRiskFlag        Boolean   @default(false)  // FLAG ROJO para trainer
  flagReviewedAt         DateTime?
  flagReviewedBy         Int?
  
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  
  // Relaciones
  Usuario                Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  Vision                 Vision?   @relation(fields: [visionId], references: [id])
  ReviewedBy             Usuario?  @relation("QuestionnaireReviewer", fields: [flagReviewedBy], references: [id])
  
  @@index([userId])
  @@index([visionId])
  @@index([status])
  @@index([suicideRiskFlag])
}

enum QuestionnaireStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ============================================
// BUDDY SYSTEM - Sistema de Compañeros
// ============================================

model BuddyPair {
  id                  String      @id @default(uuid())
  visionId            Int
  
  // Usuario que inició la solicitud
  initiatorId         Int
  initiatorAccepted   Boolean     @default(false)
  initiatorSharedAt   DateTime?
  
  // Usuario que recibe la solicitud  
  receiverId          Int
  receiverAccepted    Boolean     @default(false)
  receiverSharedAt    DateTime?
  
  // Estado del pacto
  status              BuddyStatus @default(PENDING)
  
  // Datos compartidos (solo visibles cuando status = MATCHED)
  initiatorPhone      String?
  initiatorAddress    String?
  receiverPhone       String?
  receiverAddress     String?
  
  // Timestamps
  createdAt           DateTime    @default(now())
  matchedAt           DateTime?
  brokenAt            DateTime?
  brokenBy            Int?
  brokenReason        String?
  
  // Relaciones
  vision              Vision      @relation(fields: [visionId], references: [id])
  initiator           Usuario     @relation("BuddyInitiator", fields: [initiatorId], references: [id])
  receiver            Usuario     @relation("BuddyReceiver", fields: [receiverId], references: [id])
  brokenByUser        Usuario?    @relation("BuddyBrokenBy", fields: [brokenBy], references: [id])
  
  @@unique([visionId, initiatorId])
  @@unique([visionId, receiverId])
  @@index([visionId])
  @@index([initiatorId])
  @@index([receiverId])
  @@index([status])
}

enum BuddyStatus {
  PENDING       // A solicitó, esperando respuesta de B
  MATCHED       // Ambos aceptaron - Pacto sellado
  REJECTED      // B rechazó la solicitud
  BROKEN        // Pacto roto (por abandono, etc.)
}

// ============================================
// ÁLBUM CUÁNTICO - Sistema de Fotos Coleccionables
// ============================================

// Plantilla de cada foto coleccionable (las 50+ fotos posibles)
model CollectiblePhotoTemplate {
  id              Int                     @id @default(autoincrement())
  slot            Int                     @unique // Número de slot 1-50+
  name            String                  // "El Guardián", "El Espejo", etc.
  description     String                  @db.Text // Descripción emotiva
  category        PhotoCategory           // TRIBU, ARTEFACTOS, MOMENTOS, etc.
  emoji           String                  // 📸, 🎭, etc.
  requiredLevels  ProductLevelType[]      @default([BASIC, ADVANCED]) // Qué niveles pueden desbloquear
  pointsReward    Int                     @default(50) // Puntos Cuánticos
  validationRule  PhotoValidationRule     @default(MANUAL) // Tipo de validación
  aiPrompt        String?                 @db.Text // Prompt para validación IA si aplica
  isActive        Boolean                 @default(true)
  sortOrder       Int                     @default(0) // Para ordenar dentro de categoría
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  
  // Relaciones
  UserPhotos      CollectiblePhoto[]
  
  @@index([category])
  @@index([isActive])
}

// Foto subida por el usuario para un slot específico
model CollectiblePhoto {
  id              Int                       @id @default(autoincrement())
  userId          Int
  templateId      Int
  photoUrl        String                    // URL principal (Cloudinary)
  thumbnailUrl    String?                   // URL de thumbnail
  publicId        String?                   // Cloudinary public_id para eliminación
  
  // Metadata de captura
  capturedAt      DateTime                  @default(now())
  capturedDuring  ProductLevelType?         // Durante qué nivel de entrenamiento
  visionId        Int?
  productId       Int?
  
  // Estado y validación
  status          PhotoStatus               @default(PENDING)
  validatedAt     DateTime?
  validatedBy     Int?                      // ID del staff que validó (null si fue IA/auto)
  aiValidation    Json?                     // Respuesta de IA si aplica
  rejectionReason String?
  
  // Puntos otorgados
  pointsAwarded   Int                       @default(0)
  awardedAt       DateTime?
  
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  
  // Relaciones
  User            Usuario                   @relation("UserCollectiblePhotos", fields: [userId], references: [id], onDelete: Cascade)
  Template        CollectiblePhotoTemplate  @relation(fields: [templateId], references: [id])
  Vision          Vision?                   @relation("PhotoVision", fields: [visionId], references: [id])
  Product         SchoolProduct?            @relation("PhotoProduct", fields: [productId], references: [id])
  Validator       Usuario?                  @relation("PhotoValidator", fields: [validatedBy], references: [id])
  
  @@unique([userId, templateId]) // Un usuario solo puede tener una foto por slot
  @@index([userId])
  @@index([status])
  @@index([visionId])
}

// ============================================
// LEGACY CAPTURE - Captura de datos críticos por GC
// ============================================

// Sesión de captura de datos críticos (fotos, contratos, canciones)
model LegacyCaptureSession {
  id                      Int                 @id @default(autoincrement())
  gcId                    Int                 // Game Changer que captura
  participantId           Int                 // Participante objetivo
  visionId                Int
  productId               Int?                // Opcional - puede no haber producto asociado
  level                   ProductLevelType    // BASIC, ADVANCED o PL
  
  // Estado general
  status                  LegacyCaptureStatus @default(PENDING)
  completedAt             DateTime?
  
  // === Campos BÁSICO (solo estos 3) ===
  photoWithGCUrl          String?             // Foto con el GC (BASIC)
  photoWithSquadUrl       String?             // Foto con mini grupo (BASIC)
  photoBlueWallUrl        String?             // Foto pared azul icónica (BASIC)
  
  // === Campos AVANZADO (fotos + canción + contrato) ===
  // photoWithGCUrl y photoWithSquadUrl también se usan en ADVANCED
  lullabyTitle            String?             // Nombre canción de cuna (ADVANCED)
  lullabyArtist           String?             // Artista de la canción (ADVANCED)
  lullabyAudioUrl         String?             // Audio grabado (ADVANCED)
  contractPhotoUrl        String?             // Foto del contrato firmado (ADVANCED)
  contractDeclaration     String?             @db.Text // Transcripción "Yo soy..." (ADVANCED)
  
  // === Campos PL (fotos + canción PL + salón + manta) ===
  // photoWithGCUrl y photoWithSquadUrl también se usan en PL
  plLullabyTitle          String?             // Nombre canción de cuna PL
  plLullabyArtist         String?             // Artista canción PL
  plLullabyAudioUrl       String?             // Audio grabado PL
  photoSalonUrl           String?             // Foto del salón (PL)
  photoMantaUrl           String?             // Foto de la manta (PL)
  
  // Metadata
  capturedAt              DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  
  // Relaciones
  GC                      Usuario             @relation("GCLegacyCaptures", fields: [gcId], references: [id])
  Participant             Usuario             @relation("ParticipantLegacyCaptures", fields: [participantId], references: [id])
  Vision                  Vision              @relation("VisionLegacyCaptures", fields: [visionId], references: [id])
  Product                 SchoolProduct?      @relation("ProductLegacyCaptures", fields: [productId], references: [id])
  
  @@unique([participantId, visionId]) // Una sesión por participante por visión
  @@index([gcId])
  @@index([status])
  @@index([visionId])
}

// ============================================
// CANCIONES MEMORABLES - Canciones por nivel (PL tendrá más)
// ============================================

model UserSong {
  id              Int                 @id @default(autoincrement())
  userId          Int
  visionId        Int?
  productId       Int?
  level           ProductLevelType
  
  // Tipo de canción
  songType        SongType            // LULLABY, GRADUATION, POWER, etc.
  
  // Datos de la canción
  title           String              // Nombre de la canción
  artist          String?             // Artista
  audioUrl        String?             // URL si fue grabada
  spotifyUrl      String?             // URL de Spotify si aplica
  youtubeUrl      String?             // URL de YouTube si aplica
  notes           String?             @db.Text // Notas/significado personal
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Relaciones
  User            Usuario             @relation("UserSongs", fields: [userId], references: [id], onDelete: Cascade)
  Vision          Vision?             @relation("VisionSongs", fields: [visionId], references: [id])
  Product         SchoolProduct?      @relation("ProductSongs", fields: [productId], references: [id])
  
  @@unique([userId, level, songType]) // Una canción por tipo por nivel
  @@index([userId])
  @@index([level])
}

// ============================================
// ENUMS para el sistema de fotos y legacy capture
// ============================================

enum PhotoCategory {
  TRIBU       // Conexiones humanas (1-10)
  ARTEFACTOS  // Símbolos y objetos (11-20)
  MOMENTOS    // Acción y energía (21-30)
  REFLEJOS    // Introspección (31-40)
  ENTORNO     // Easter eggs del venue (41-50)
}

enum PhotoValidationRule {
  MANUAL        // Requiere aprobación de staff
  AI_PERSON     // IA debe detectar persona(s)
  AI_BADGE      // IA debe detectar gafete/texto
  AI_GROUP      // IA debe detectar grupo de personas
  AI_OBJECT     // IA debe detectar objeto específico
  AUTO_APPROVE  // Se aprueba automáticamente
}

enum PhotoStatus {
  PENDING   // Subida, esperando validación
  APPROVED  // Validada y puntos otorgados
  REJECTED  // Rechazada (razón en rejectionReason)
}

enum LegacyCaptureStatus {
  PENDING       // Sin iniciar
  IN_PROGRESS   // En proceso de captura
  COMPLETED     // Todos los campos requeridos completos
}

enum SongType {
  LULLABY         // Canción de cuna (Avanzado)
  GRADUATION      // Canción de graduación
  POWER           // Canción de poder personal
  TRANSFORMATION  // Canción de transformación (PL)
  VICTORY         // Canción de victoria (PL)
}

// Modelo para rastrear checkouts abandonados y ofrecer anticipos
model AbandonedCheckout {
  id              String                  @id @default(cuid())
  
  // Usuario que abandonó (puede ser null si no completó registro)
  userId          Int?
  user            Usuario?                @relation(fields: [userId], references: [id])
  
  // Datos del intento de registro
  email           String
  phone           String?
  firstName       String?
  lastName        String?
  
  // Visión a la que intentaba inscribirse
  visionId        Int
  vision          Vision                  @relation(fields: [visionId], references: [id])
  
  // Organización
  organizationId  Int
  organization    Organization            @relation(fields: [organizationId], references: [id])
  
  // Precio y monto
  originalPrice   Decimal                 @db.Decimal(10, 2)
  anticipoAmount  Decimal?                @db.Decimal(10, 2)
  
  // Ticket creado (si se crea al abandonar)
  ticketId        String?
  ticket          Ticket?                 @relation(fields: [ticketId], references: [id])
  
  // Estado del abandono
  status          AbandonedCheckoutStatus @default(ABANDONED)
  
  // Timestamps
  checkoutStartedAt DateTime              @default(now())
  abandonedAt       DateTime?
  emailSentAt       DateTime?
  convertedAt       DateTime?             // Cuando pagó (anticipo o completo)
  
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  
  @@index([userId])
  @@index([email])
  @@index([visionId])
  @@index([organizationId])
  @@index([status])
  @@index([checkoutStartedAt])
}

enum AbandonedCheckoutStatus {
  IN_CHECKOUT       // Usuario en proceso de checkout
  ABANDONED         // Abandonó (5 min sin actividad)
  EMAIL_SENT        // Se envió email de anticipo
  CONVERTED_ANTICIPO // Pagó anticipo
  CONVERTED_FULL    // Pagó completo
  EXPIRED           // Expiró sin pagar
}

// ============================================
// LEGACY BUILDER - Sistema de Crowdfunding Auditado
// ============================================

// Proyecto Global (Legado Maestro) - Nivel 1
model LegacyProject {
  id              Int                 @id @default(autoincrement())
  
  // Información básica
  title           String              // "Techo Casa Hogar"
  slug            String              @unique // URL amigable
  description     String?             @db.Text
  story           String?             @db.Text // Historia/manifiesto
  videoUrl        String?             // Embed YouTube/Vimeo
  
  // Imágenes
  coverImage      String?             // Imagen de portada
  galleryImages   String[]            // Galería de fotos
  
  // Meta financiera
  goalAmount      Decimal             @db.Decimal(12, 2) // Meta total (ej. $500,000)
  raisedAmount    Decimal             @default(0) @db.Decimal(12, 2) // Recaudado total
  
  // Organización propietaria
  organizationId  Int
  organization    Organization        @relation(fields: [organizationId], references: [id])
  
  // Estado
  status          LegacyProjectStatus @default(DRAFT)
  isPublic        Boolean             @default(false)
  isFeatured      Boolean             @default(false)
  
  // Categoría
  category        String?             // "Vivienda", "Educación", "Salud"
  
  // Fechas
  startDate       DateTime?
  endDate         DateTime?
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Relaciones
  campaigns       LegacyCampaign[]
  
  @@index([organizationId])
  @@index([slug])
  @@index([status])
  @@index([isPublic])
}

// Campaña de Visión (Child Campaign) - Nivel 2
model LegacyCampaign {
  id              Int                  @id @default(autoincrement())
  
  // Proyecto padre
  projectId       Int
  project         LegacyProject        @relation(fields: [projectId], references: [id])
  
  // Visión que lidera la campaña
  visionId        Int
  vision          Vision               @relation(fields: [visionId], references: [id])
  
  // Capitán de la campaña (líder)
  captainId       Int
  captain         Usuario              @relation("LegacyCampaignCaptain", fields: [captainId], references: [id])
  
  // Información de la campaña
  title           String               // "Visión Águilas por la Casa Hogar"
  slug            String               @unique
  description     String?              @db.Text
  story           String?              @db.Text
  videoUrl        String?
  
  // Imágenes
  coverImage      String?
  logoImage       String?
  
  // Meta financiera
  goalAmount      Decimal              @db.Decimal(12, 2) // Meta del equipo (ej. $50,000)
  raisedAmount    Decimal              @default(0) @db.Decimal(12, 2) // Recaudado
  availableAmount Decimal              @default(0) @db.Decimal(12, 2) // Disponible (recaudado - gastado)
  
  // Estado
  status          LegacyCampaignStatus @default(DRAFT)
  isPublic        Boolean              @default(false)
  
  // Fechas
  startDate       DateTime?
  endDate         DateTime?
  
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  // Relaciones
  donations       LegacyDonation[]
  expenses        LegacyExpense[]
  members         LegacyCampaignMember[]
  
  @@index([projectId])
  @@index([visionId])
  @@index([captainId])
  @@index([slug])
  @@index([status])
}

// Miembros de la campaña (para gamificación/leaderboard)
model LegacyCampaignMember {
  id              Int              @id @default(autoincrement())
  
  campaignId      Int
  campaign        LegacyCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  userId          Int
  user            Usuario          @relation(fields: [userId], references: [id])
  
  // Código de referido único para tracking
  referralCode    String           @unique @default(cuid())
  referralUrl     String?          // URL personalizada
  
  // Stats de recaudación
  totalRaised     Decimal          @default(0) @db.Decimal(12, 2)
  donationsCount  Int              @default(0)
  
  // Rol en la campaña
  role            CampaignMemberRole @default(MEMBER)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Donaciones referidas por este miembro
  referredDonations LegacyDonation[]
  
  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@index([referralCode])
}

// Donaciones
model LegacyDonation {
  id              Int                  @id @default(autoincrement())
  
  // Campaña que recibe la donación
  campaignId      Int
  campaign        LegacyCampaign       @relation(fields: [campaignId], references: [id])
  
  // Donador (puede ser anónimo)
  donorName       String?
  donorEmail      String
  donorPhone      String?
  isAnonymous     Boolean              @default(false)
  
  // Usuario registrado (opcional)
  userId          Int?
  user            Usuario?             @relation(fields: [userId], references: [id])
  
  // Referido por (tracking)
  referredById    Int?
  referredBy      LegacyCampaignMember? @relation(fields: [referredById], references: [id])
  
  // Monto
  amount          Decimal              @db.Decimal(12, 2)
  currency        String               @default("MXN")
  
  // Pago
  paymentMethod   String?              // "stripe", "mercadopago", "transfer"
  paymentId       String?              // ID de la transacción externa
  paymentStatus   DonationPaymentStatus @default(PENDING)
  
  // Mensaje de dedicación
  message         String?              @db.Text
  showMessage     Boolean              @default(true) // Mostrar en muro
  
  // Estado del dinero
  moneyStatus     DonationMoneyStatus  @default(COLLECTED)
  
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  @@index([campaignId])
  @@index([userId])
  @@index([referredById])
  @@index([donorEmail])
  @@index([paymentStatus])
  @@index([moneyStatus])
}

// Solicitudes de Gasto
model LegacyExpense {
  id              Int                  @id @default(autoincrement())
  
  // Campaña que solicita el gasto
  campaignId      Int
  campaign        LegacyCampaign       @relation(fields: [campaignId], references: [id])
  
  // Quién solicita
  requestedById   Int
  requestedBy     Usuario              @relation("LegacyExpenseRequester", fields: [requestedById], references: [id])
  
  // Detalles del gasto
  concept         String               // "50 bultos cemento"
  description     String?              @db.Text
  amount          Decimal              @db.Decimal(12, 2)
  
  // Proveedor
  providerName    String?
  providerRFC     String?
  providerBank    String?
  providerClabe   String?
  
  // Evidencia/Comprobantes
  quotationUrl    String?              // Cotización
  invoiceUrl      String?              // Factura
  evidenceUrls    String[]             // Fotos adicionales
  
  // Estado de auditoría
  status          LegacyExpenseStatus  @default(REQUESTED)
  
  // Auditoría
  auditedById     Int?
  auditedBy       Usuario?             @relation("LegacyExpenseAuditor", fields: [auditedById], references: [id])
  auditedAt       DateTime?
  auditComments   String?              @db.Text
  
  // Dispersión
  dispersedById   Int?
  dispersedBy     Usuario?             @relation("LegacyExpenseDisperser", fields: [dispersedById], references: [id])
  dispersedAt     DateTime?
  dispersalRef    String?              // Referencia SPEI/transferencia
  
  // Publicación
  isPublished     Boolean              @default(false)
  publishedAt     DateTime?
  publicImageUrl  String?              // Imagen para mostrar público
  
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  @@index([campaignId])
  @@index([requestedById])
  @@index([status])
  @@index([isPublished])
}

// ============================================
// ENUMS para Legacy Builder
// ============================================

enum LegacyProjectStatus {
  DRAFT           // Borrador
  ACTIVE          // Activo y recibiendo donaciones
  PAUSED          // Pausado temporalmente
  COMPLETED       // Meta alcanzada
  CANCELLED       // Cancelado
}

enum LegacyCampaignStatus {
  DRAFT           // Borrador
  PENDING_REVIEW  // Pendiente de aprobación
  ACTIVE          // Activo
  PAUSED          // Pausado
  COMPLETED       // Completado
  CANCELLED       // Cancelado
}

enum CampaignMemberRole {
  CAPTAIN         // Líder de la campaña
  COORDINATOR     // Coordinador
  MEMBER          // Miembro regular
}

enum DonationMoneyStatus {
  PENDING         // Pago pendiente
  COLLECTED       // Dinero recibido en cuenta concentradora
  ALLOCATED       // Asignado a un gasto
  DISBURSED       // Ya se dispersó
}

enum LegacyExpenseStatus {
  REQUESTED       // Solicitado por la visión
  UNDER_REVIEW    // En revisión por auditor
  APPROVED        // Aprobado por auditor
  REJECTED        // Rechazado (con comentarios)
  PAID_OUT        // Transferencia realizada
  PUBLISHED       // Publicado en transparencia
}

enum DonationPaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ============================================
// DIRECTORIO DE TALENTOS - Bolsa de Trabajo Interna
// ============================================

model BusinessProfile {
  id                  Int                    @id @default(autoincrement())
  userId              Int                    @unique
  organizationId      Int
  visionId            Int?
  
  // Información del perfil
  headline            String                 @db.VarChar(100)     // "Arquitecto Bioclimático"
  categoryId          Int
  description         String                 @db.Text             // El pitch
  discountOffer       String                 @db.VarChar(200)     // "15% de descuento para la comunidad"
  
  // Ubicación
  city                String
  state               String
  coverageZone        String?                                     // Zona de cobertura adicional
  
  // Contacto
  whatsappPhone       String                 @db.VarChar(20)
  email               String?
  website             String?
  
  // Portafolio
  galleryImages       String[]               @default([])         // Hasta 5 fotos
  logoUrl             String?
  
  // Reputación (caché para queries rápidos)
  avgRating           Float                  @default(0)          // Promedio de calificaciones
  totalReviews        Int                    @default(0)          // Total de reseñas
  oneStarCount        Int                    @default(0)          // Contador de 1 estrella (para auto-ban)
  
  // Estados y badges
  status              BusinessProfileStatus  @default(PENDING)
  isVerified          Boolean                @default(false)      // Tick azul si graduó de PL
  isPLGraduate        Boolean                @default(false)      // Marco dorado
  
  // Timestamps
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  suspendedAt         DateTime?                                   // Si fue suspendido
  suspensionReason    String?
  
  // Relaciones
  user                Usuario                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vision              Vision?                @relation(fields: [visionId], references: [id])
  category            BusinessCategory       @relation(fields: [categoryId], references: [id])
  reviews             ServiceReview[]        @relation("ProfileReviews")
  
  @@index([organizationId])
  @@index([visionId])
  @@index([categoryId])
  @@index([status])
  @@index([avgRating])
  @@index([city, state])
}

model BusinessCategory {
  id              Int               @id @default(autoincrement())
  name            String            @unique                       // "Salud", "Construcción", etc.
  slug            String            @unique
  icon            String?                                         // Emoji o nombre de icono
  description     String?
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  
  profiles        BusinessProfile[]
  
  @@index([isActive])
  @@index([sortOrder])
}

model ServiceReview {
  id                  Int             @id @default(autoincrement())
  profileId           Int                                         // Perfil que recibe la reseña
  authorId            Int                                         // Usuario que escribe
  
  rating              Int                                         // 1-5 estrellas
  comment             String          @db.Text                    // Comentario obligatorio (min 10 chars)
  didHireService      Boolean         @default(false)             // "Declaro que contraté este servicio"
  
  // Metadatos
  isPublic            Boolean         @default(true)
  isVerified          Boolean         @default(false)             // Si se verificó la contratación
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  // Relaciones
  profile             BusinessProfile @relation("ProfileReviews", fields: [profileId], references: [id], onDelete: Cascade)
  author              Usuario         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  // Un usuario solo puede dejar una reseña por perfil
  @@unique([profileId, authorId])
  @@index([profileId])
  @@index([authorId])
  @@index([rating])
  @@index([createdAt])
}

enum BusinessProfileStatus {
  PENDING           // Pendiente de aprobación
  ACTIVE            // Activo y visible
  HIDDEN            // Oculto por el usuario
  SUSPENDED         // Suspendido por admin
  BANNED            // Baneado (5+ reseñas de 1 estrella)
}

