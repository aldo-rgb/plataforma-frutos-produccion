model VisionCommissionConfig {
  id                Int      @id @default(autoincrement())
  visionId          Int      @unique
  basicSeatedRate   Decimal  @default(300) @db.Decimal(10, 2)
  advanceSeatedRate Decimal  @default(500) @db.Decimal(10, 2)
  plStartRate       Decimal  @default(400) @db.Decimal(10, 2)
  plGuestRate       Decimal  @default(400) @db.Decimal(10, 2)
  plGradRate        Decimal  @default(400) @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  updatedBy         Int?
  Usuario           Usuario? @relation(fields: [updatedBy], references: [id])
  Vision            Vision   @relation(fields: [visionId], references: [id], onDelete: Cascade)

  @@index([visionId])
}

model VisionEscrow {
  id               Int            @id @default(autoincrement())
  visionId         Int            @unique
  totalDeposited   Decimal        @db.Decimal(10, 2)
  totalPaid        Decimal        @default(0) @db.Decimal(10, 2)
  remainingBalance Decimal        @db.Decimal(10, 2)
  status           EscrowStatus   @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  closedAt         DateTime?
  MentorPayout     MentorPayout[]
  Vision           Vision         @relation(fields: [visionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([visionId])
}

