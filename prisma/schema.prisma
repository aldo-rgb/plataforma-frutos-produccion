  Usuario                    Usuario              @relation(fields: [coordinadorId], references: [id], onDelete: Cascade)
  Organization               Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  VisionGameChanger          VisionGameChanger[]
  VisionMentor               VisionMentor[]
  VisionParticipante         VisionParticipante[]
  VisionEscrow               VisionEscrow?
  MentorPackageOrder         MentorPackageOrder[]
  RefundRequest              RefundRequest[]      @relation("RefundRequestVision")

  @@index([coordinadorId])
  @@index([isActive])
  @@index([organizationId])
}

model VisionGameChanger {
  id                                               Int      @id @default(autoincrement())
