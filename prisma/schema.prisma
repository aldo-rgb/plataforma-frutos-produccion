model Vision {
  id                         Int                  @id @default(autoincrement())
  nombre                     String
  descripcion                String?
  coordinadorId              Int
  isActive                   Boolean              @default(true)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime
  licensesAllocated          Int                  @default(0)
  maxParticipantes           Int?
  organizationId             Int?
  endDate                    DateTime?
  startDate                  DateTime?
  forceCommunityServiceArea  Boolean              @default(true)
  forceTransformationArea    Boolean              @default(true)
  transformationGuestsTarget Int?                 @default(4)
  forceFinanzasArea          Boolean              @default(true)
  forceOcioArea              Boolean              @default(true)
  forcePazMentalArea         Boolean              @default(true)
  forceRelacionesArea        Boolean              @default(true)
  forceSaludArea             Boolean              @default(true)
  forceTalentosArea          Boolean              @default(true)
