  createdAt    DateTime       @default(now())
  Pattern      QuantumPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  Usuario      Usuario        @relation("QuantumInsights", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, viewed])
  @@index([createdAt])
}

model ArenaDuel {
  id                Int                @id @default(autoincrement())
  player1Id         Int
  player2Id         Int
  status            DuelStatus         @default(MATCHING)
  betAmount         Int                @default(500)
  escrowTotal       Int                @default(1000)
  startDate         DateTime           @db.Date
  endDate           DateTime           @db.Date
  player1HP         Int                @default(100)
  player2HP         Int                @default(100)
  player1Completion Float              @default(0)
  player2Completion Float              @default(0)
  winnerId          Int?
  prize             Int?
  resolvedAt        DateTime?
  resolutionType    ResolutionType?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  DailyUpdates      ArenaDailyUpdate[]
  Player1           Usuario            @relation("DuelPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  Player2           Usuario            @relation("DuelPlayer2", fields: [player2Id], references: [id], onDelete: Cascade)
  Winner            Usuario?           @relation("DuelWinner", fields: [winnerId], references: [id])
  Taunts            ArenaTaunt[]

  @@index([status])
  @@index([startDate, endDate])
  @@index([player1Id])
  @@index([player2Id])
}

model ArenaDailyUpdate {
  id            Int       @id @default(autoincrement())
  duelId        Int
  date          DateTime  @db.Date
  player1HP     Int
  player2HP     Int
  player1Damage Int       @default(0)
  player2Damage Int       @default(0)
  player1Failed Boolean   @default(false)
  player2Failed Boolean   @default(false)
  narration     String?
  createdAt     DateTime  @default(now())
  Duel          ArenaDuel @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, date])
  @@index([duelId])
}

model ArenaTaunt {
  id            Int       @id @default(autoincrement())
  duelId        Int
  senderId      Int
  receiverId    Int
  tauntType     TauntType
  customMessage String?
  read          Boolean   @default(false)
  createdAt     DateTime  @default(now())
  Duel          ArenaDuel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  Receiver      Usuario   @relation("TauntReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  Sender        Usuario   @relation("TauntSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([duelId])
  @@index([receiverId, read])
}

model ArenaQueue {
  id        Int         @id @default(autoincrement())
  usuarioId Int         @unique
  userLevel String
  timezone  String      @default("America/Mexico_City")
  pcBalance Int
  status    QueueStatus @default(SEARCHING)
  enteredAt DateTime    @default(now())
  expiresAt DateTime
  Usuario   Usuario     @relation("ArenaQueue", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([status, userLevel])
  @@index([expiresAt])
}

model ArenaStats {
  id            Int       @id @default(autoincrement())
  usuarioId     Int       @unique
  totalDuels    Int       @default(0)
  wins          Int       @default(0)
  losses        Int       @default(0)
  ties          Int       @default(0)
  totalWagered  Int       @default(0)
  totalWon      Int       @default(0)
  totalLost     Int       @default(0)
  netProfit     Int       @default(0)
  currentStreak Int       @default(0)
  bestStreak    Int       @default(0)
  badges        String[]  @default([])
  lastDuelAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  Usuario       Usuario   @relation("ArenaStats", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  relatedId Int?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  usuario   Usuario          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

