  productType       AmbassadorProductType
  saleAmount        Decimal               @db.Decimal(10, 2)
  commissionPercent Decimal               @db.Decimal(5, 2)
  commissionAmount  Decimal               @db.Decimal(10, 2)
  status            AmbassadorTxStatus    @default(CLEARED)
  withdrawnAt       DateTime?
  spentAt           DateTime?
  notes             String?
  organizationId    Int
  visionId          Int?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  ambassador        Usuario               @relation("ambassador_wallet_ambassador", fields: [ambassadorId], references: [id])
  Organization      Organization          @relation(fields: [organizationId], references: [id])
  referredUser      Usuario               @relation("ambassador_wallet_referred", fields: [referredUserId], references: [id])
  Ticket            Ticket?               @relation(fields: [ticketId], references: [id])
  Vision            Vision?               @relation(fields: [visionId], references: [id])

  @@index([ambassadorId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
}

model ambassador_withdrawal_requests {
  id             Int              @id @default(autoincrement())
  ambassadorId   Int
  amount         Decimal          @db.Decimal(10, 2)
  bankClabe      String
  bankName       String?
  accountHolder  String?
  status         WithdrawalStatus @default(PENDING)
  approvedBy     Int?
  approvedAt     DateTime?
  rejectedReason String?
  transferRef    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  ambassador     Usuario          @relation("ambassador_withdrawals", fields: [ambassadorId], references: [id])
  approver       Usuario?         @relation("ambassador_withdrawal_approver", fields: [approvedBy], references: [id])

  @@index([ambassadorId])
  @@index([status])
}

