generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AbandonedCheckout {
  id                String                  @id
  userId            Int?
  email             String
  phone             String?
  firstName         String?
  lastName          String?
  visionId          Int
  organizationId    Int
  originalPrice     Decimal                 @db.Decimal(10, 2)
  anticipoAmount    Decimal?                @db.Decimal(10, 2)
  ticketId          String?
  status            AbandonedCheckoutStatus @default(ABANDONED)
  checkoutStartedAt DateTime                @default(now())
  abandonedAt       DateTime?
  emailSentAt       DateTime?
  convertedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime
  registrationData  Json?
  passwordHash      String?
  Organization      Organization            @relation(fields: [organizationId], references: [id])
  Ticket            Ticket?                 @relation(fields: [ticketId], references: [id])
  Usuario           Usuario?                @relation(fields: [userId], references: [id])
  Vision            Vision                  @relation(fields: [visionId], references: [id])

  @@index([checkoutStartedAt])
  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@index([userId])
  @@index([visionId])
}

model AccessCode {
  id                                      Int          @id @default(autoincrement())
  code                                    String       @unique
  ticketId                                Int
  visionId                                Int
  generatedBy                             Int
  usedBy                                  Int?
  amount                                  Float
  currency                                String       @default("MXN")
  status                                  String       @default("ACTIVE")
  expiresAt                               DateTime?
  usedAt                                  DateTime?
  metadata                                Json?
  createdAt                               DateTime     @default(now())
  Usuario_AccessCode_generatedByToUsuario Usuario      @relation("AccessCode_generatedByToUsuario", fields: [generatedBy], references: [id], onDelete: Cascade)
  VisionTicket                            VisionTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  Usuario_AccessCode_usedByToUsuario      Usuario?     @relation("AccessCode_usedByToUsuario", fields: [usedBy], references: [id])

  @@index([code])
  @@index([generatedBy])
  @@index([status])
  @@index([ticketId])
  @@index([visionId])
}

model Accion {
  id                Int               @id @default(autoincrement())
  metaId            Int
  texto             String
  diasProgramados   String?
  completada        Boolean           @default(false)
  enRevision        Boolean           @default(false)
  requiereEvidencia Boolean           @default(true)
  lastCompletedDate DateTime?
  frequency         String?
  assignedDays      Int[]
  specificDate      DateTime?
  rarity            TaskRarity        @default(COMMON)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  Meta              Meta              @relation(fields: [metaId], references: [id], onDelete: Cascade)
  EvidenciaAccion   EvidenciaAccion[]
  TaskInstance      TaskInstance[]
}

model AdminTask {
  id                Int              @id @default(autoincrement())
  type              AdminTaskType
  titulo            String
  descripcion       String?
  pointsReward      Int              @default(0)
  targetType        TargetType
  targetId          Int?
  fechaLimite       DateTime?        @db.Date
  fechaEvento       DateTime?
  horaEvento        String?
  lugar             String?
  requiereEvidencia Boolean          @default(false)
  isActive          Boolean          @default(true)
  createdBy         Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  rewardLogic       RewardLogic      @default(STANDARD)
  raceLimit         Int?
  strictDeadline    Boolean          @default(false)
  diaNumero         Int?
  duracionDias      Int?
  horaLimiteDiaria  String?
  isMultiDay        Boolean          @default(false)
  parentTaskId      Int?
  Usuario           Usuario          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  AdminTask         AdminTask?       @relation("AdminTaskToAdminTask", fields: [parentTaskId], references: [id], onDelete: Cascade)
  other_AdminTask   AdminTask[]      @relation("AdminTaskToAdminTask")
  TaskSubmission    TaskSubmission[]

  @@index([fechaLimite])
  @@index([isActive])
  @@index([isMultiDay])
  @@index([parentTaskId])
  @@index([rewardLogic])
  @@index([targetType])
  @@index([type])
}

model AdvancedPreRegistration {
  id                                                                    String                @id
  userId                                                                Int
  currentProductId                                                      Int
  targetProductId                                                       Int
  enrollmentId                                                          Int?
  scannedByStaffId                                                      Int
  scannedAt                                                             DateTime              @default(now())
  scanMethod                                                            ScanMethod            @default(QR)
  status                                                                PreRegistrationStatus @default(PENDING)
  promoPrice                                                            Float
  regularPrice                                                          Float
  promoDeadline                                                         DateTime
  paidAt                                                                DateTime?
  paymentAmount                                                         Float?
  paymentMethod                                                         String?
  transactionId                                                         String?
  createdAt                                                             DateTime              @default(now())
  updatedAt                                                             DateTime
  SchoolProduct_AdvancedPreRegistration_currentProductIdToSchoolProduct SchoolProduct         @relation("AdvancedPreRegistration_currentProductIdToSchoolProduct", fields: [currentProductId], references: [id])
  vision_enrollments                                                    vision_enrollments?   @relation(fields: [enrollmentId], references: [id])
  Usuario_AdvancedPreRegistration_scannedByStaffIdToUsuario             Usuario               @relation("AdvancedPreRegistration_scannedByStaffIdToUsuario", fields: [scannedByStaffId], references: [id])
  SchoolProduct_AdvancedPreRegistration_targetProductIdToSchoolProduct  SchoolProduct         @relation("AdvancedPreRegistration_targetProductIdToSchoolProduct", fields: [targetProductId], references: [id])
  Usuario_AdvancedPreRegistration_userIdToUsuario                       Usuario               @relation("AdvancedPreRegistration_userIdToUsuario", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetProductId])
  @@index([currentProductId])
  @@index([promoDeadline])
  @@index([scannedAt])
  @@index([status])
  @@index([targetProductId])
  @@index([userId])
}

model AdvancedQuestionnaire {
  id                                                    Int                 @id @default(autoincrement())
  userId                                                Int                 @unique
  visionId                                              Int?
  status                                                QuestionnaireStatus @default(NOT_STARTED)
  currentDimension                                      Int                 @default(0)
  lastSavedAt                                           DateTime?
  completedAt                                           DateTime?
  maritalStatus                                         String?
  partnerRelationship                                   String?
  partnerRelationshipScore                              Int?
  hasChildren                                           Boolean?
  childrenData                                          Json?
  parentsRelationship                                   String?
  siblingsCount                                         Int?
  siblingsRelationship                                  String?
  hasCompanion                                          Boolean?
  companionName                                         String?
  companionRelation                                     String?
  healthStatus                                          String?
  currentMedications                                    String?
  isPregnant                                            Boolean?
  hasSuicideAttempt                                     Boolean?
  suicideAttemptReason                                  String?
  childhoodEvent                                        String?
  childhoodMeaning                                      String?
  adolescenceEvent                                      String?
  adolescenceMeaning                                    String?
  adulthoodEvent                                        String?
  adulthoodMeaning                                      String?
  eventsInfluence                                       String?
  externalPerception                                    String?
  friendsPerception                                     String?
  religiousBeliefs                                      String?
  educationBeliefs                                      String?
  workDescription                                       String?
  triggers                                              String?
  lifePurpose                                           String?
  suicideRiskFlag                                       Boolean             @default(false)
  flagReviewedAt                                        DateTime?
  flagReviewedBy                                        Int?
  createdAt                                             DateTime            @default(now())
  updatedAt                                             DateTime
  Usuario_AdvancedQuestionnaire_flagReviewedByToUsuario Usuario?            @relation("AdvancedQuestionnaire_flagReviewedByToUsuario", fields: [flagReviewedBy], references: [id])
  Usuario_AdvancedQuestionnaire_userIdToUsuario         Usuario             @relation("AdvancedQuestionnaire_userIdToUsuario", fields: [userId], references: [id], onDelete: Cascade)
  Vision                                                Vision?             @relation(fields: [visionId], references: [id])

  @@index([status])
  @@index([suicideRiskFlag])
  @@index([userId])
  @@index([visionId])
}

model Archetype {
  id                  Int                   @id @default(autoincrement())
  trainerId           Int?
  organizationId      Int?
  name                String
  category            ArchetypeCategory     @default(CUSTOM)
  maneraSerTag        String
  maneraSerLabel      String
  scriptFeedback      String
  description         String?
  imageUrl            String?
  isSystemDefault     Boolean               @default(false)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Organization        Organization?         @relation(fields: [organizationId], references: [id])
  Usuario             Usuario?              @relation(fields: [trainerId], references: [id])
  ArchetypeAssignment ArchetypeAssignment[]

  @@index([category])
  @@index([isSystemDefault])
  @@index([organizationId])
  @@index([trainerId])
}

model ArchetypeAssignment {
  id                                                 Int                       @id @default(autoincrement())
  archetypeId                                        Int
  participantId                                      Int
  assignedById                                       Int
  visionId                                           Int?
  productId                                          Int?
  status                                             ArchetypeAssignmentStatus @default(SENT)
  customNote                                         String?
  viewedAt                                           DateTime?
  acceptedAt                                         DateTime?
  transformedAt                                      DateTime?
  responseText                                       String?
  responseVideoUrl                                   String?
  createdAt                                          DateTime                  @default(now())
  updatedAt                                          DateTime
  Archetype                                          Archetype                 @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  Usuario_ArchetypeAssignment_assignedByIdToUsuario  Usuario                   @relation("ArchetypeAssignment_assignedByIdToUsuario", fields: [assignedById], references: [id])
  Usuario_ArchetypeAssignment_participantIdToUsuario Usuario                   @relation("ArchetypeAssignment_participantIdToUsuario", fields: [participantId], references: [id])
  SchoolProduct                                      SchoolProduct?            @relation(fields: [productId], references: [id])
  Vision                                             Vision?                   @relation(fields: [visionId], references: [id])

  @@index([archetypeId])
  @@index([assignedById])
  @@index([createdAt])
  @@index([participantId])
  @@index([status])
  @@index([visionId])
}

model AreaConfig {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  areaKey   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, areaKey])
  @@index([usuarioId])
}

model ArenaDailyUpdate {
  id            Int       @id @default(autoincrement())
  duelId        Int
  date          DateTime  @db.Date
  player1HP     Int
  player2HP     Int
  player1Damage Int       @default(0)
  player2Damage Int       @default(0)
  player1Failed Boolean   @default(false)
  player2Failed Boolean   @default(false)
  narration     String?
  createdAt     DateTime  @default(now())
  ArenaDuel     ArenaDuel @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, date])
  @@index([duelId])
}

model ArenaDuel {
  id                                   Int                @id @default(autoincrement())
  player1Id                            Int
  player2Id                            Int
  status                               DuelStatus         @default(MATCHING)
  betAmount                            Int                @default(500)
  escrowTotal                          Int                @default(1000)
  startDate                            DateTime           @db.Date
  endDate                              DateTime           @db.Date
  player1HP                            Int                @default(100)
  player2HP                            Int                @default(100)
  player1Completion                    Float              @default(0)
  player2Completion                    Float              @default(0)
  winnerId                             Int?
  prize                                Int?
  resolvedAt                           DateTime?
  resolutionType                       ResolutionType?
  createdAt                            DateTime           @default(now())
  updatedAt                            DateTime
  ArenaDailyUpdate                     ArenaDailyUpdate[]
  Usuario_ArenaDuel_player1IdToUsuario Usuario            @relation("ArenaDuel_player1IdToUsuario", fields: [player1Id], references: [id], onDelete: Cascade)
  Usuario_ArenaDuel_player2IdToUsuario Usuario            @relation("ArenaDuel_player2IdToUsuario", fields: [player2Id], references: [id], onDelete: Cascade)
  Usuario_ArenaDuel_winnerIdToUsuario  Usuario?           @relation("ArenaDuel_winnerIdToUsuario", fields: [winnerId], references: [id])
  ArenaTaunt                           ArenaTaunt[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([startDate, endDate])
  @@index([status])
}

model ArenaQueue {
  id        Int         @id @default(autoincrement())
  usuarioId Int         @unique
  userLevel String
  timezone  String      @default("America/Mexico_City")
  pcBalance Int
  status    QueueStatus @default(SEARCHING)
  enteredAt DateTime    @default(now())
  expiresAt DateTime
  Usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([status, userLevel])
}

model ArenaStats {
  id            Int       @id @default(autoincrement())
  usuarioId     Int       @unique
  totalDuels    Int       @default(0)
  wins          Int       @default(0)
  losses        Int       @default(0)
  ties          Int       @default(0)
  totalWagered  Int       @default(0)
  totalWon      Int       @default(0)
  totalLost     Int       @default(0)
  netProfit     Int       @default(0)
  currentStreak Int       @default(0)
  bestStreak    Int       @default(0)
  badges        String[]  @default([])
  lastDuelAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model ArenaTaunt {
  id                                     Int       @id @default(autoincrement())
  duelId                                 Int
  senderId                               Int
  receiverId                             Int
  tauntType                              TauntType
  customMessage                          String?
  read                                   Boolean   @default(false)
  createdAt                              DateTime  @default(now())
  ArenaDuel                              ArenaDuel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  Usuario_ArenaTaunt_receiverIdToUsuario Usuario   @relation("ArenaTaunt_receiverIdToUsuario", fields: [receiverId], references: [id], onDelete: Cascade)
  Usuario_ArenaTaunt_senderIdToUsuario   Usuario   @relation("ArenaTaunt_senderIdToUsuario", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([duelId])
  @@index([receiverId, read])
}

model AutoLoginToken {
  id        String    @id
  token     String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  Usuario   Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([token])
  @@index([userId])
}

model AutomationMessageLog {
  id             Int                     @id @default(autoincrement())
  organizationId Int
  userId         Int
  videoKey       String
  videoLabel     String
  channel        AutomationChannel
  recipient      String
  status         AutomationMessageStatus @default(PENDING)
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime                @default(now())
  source         AutomationSource        @default(MANUAL)
  visionId       Int?
  Organization   Organization            @relation(fields: [organizationId], references: [id])
  Usuario        Usuario                 @relation(fields: [userId], references: [id])
  Vision         Vision?                 @relation(fields: [visionId], references: [id])

  @@index([createdAt])
  @@index([organizationId])
  @@index([status])
  @@index([userId])
  @@index([videoKey])
}

model AvatarGenerationAttempt {
  id           Int      @id @default(autoincrement())
  usuarioId    Int
  sourceImage  String
  generatedUrl String
  vibe         String   @default("cyberpunk")
  gender       String
  createdAt    DateTime @default(now())
  Usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([usuarioId])
}

model BasicCallTracking {
  id                     Int                  @id @default(autoincrement())
  enrollmentId           Int                  @unique
  nickname               String?
  phone                  String?
  preferredCallTimeStart String?
  preferredCallTimeEnd   String?
  coordinatorId          Int?
  attendanceStatus       AttendanceStatus     @default(PENDING)
  callAttempts           Int                  @default(0)
  lastInteractionAt      DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime
  Usuario                Usuario?             @relation(fields: [coordinatorId], references: [id])
  vision_enrollments     vision_enrollments   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  CallInteractionLog     CallInteractionLog[]

  @@index([attendanceStatus])
  @@index([coordinatorId])
  @@index([enrollmentId])
  @@index([preferredCallTimeStart])
}

model BuddyPair {
  id                                     String      @id
  visionId                               Int
  initiatorId                            Int
  initiatorAccepted                      Boolean     @default(false)
  initiatorSharedAt                      DateTime?
  receiverId                             Int
  receiverAccepted                       Boolean     @default(false)
  receiverSharedAt                       DateTime?
  status                                 BuddyStatus @default(PENDING)
  initiatorPhone                         String?
  initiatorAddress                       String?
  receiverPhone                          String?
  receiverAddress                        String?
  createdAt                              DateTime    @default(now())
  matchedAt                              DateTime?
  brokenAt                               DateTime?
  brokenBy                               Int?
  brokenReason                           String?
  Usuario_BuddyPair_brokenByToUsuario    Usuario?    @relation("BuddyPair_brokenByToUsuario", fields: [brokenBy], references: [id])
  Usuario_BuddyPair_initiatorIdToUsuario Usuario     @relation("BuddyPair_initiatorIdToUsuario", fields: [initiatorId], references: [id])
  Usuario_BuddyPair_receiverIdToUsuario  Usuario     @relation("BuddyPair_receiverIdToUsuario", fields: [receiverId], references: [id])
  Vision                                 Vision      @relation(fields: [visionId], references: [id])

  @@unique([visionId, initiatorId])
  @@unique([visionId, receiverId])
  @@index([initiatorId])
  @@index([receiverId])
  @@index([status])
  @@index([visionId])
}

model BusinessCategory {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  slug            String            @unique
  icon            String?
  description     String?
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  BusinessProfile BusinessProfile[]

  @@index([isActive])
  @@index([sortOrder])
}

model BusinessNudge {
  id              Int             @id @default(autoincrement())
  profileId       Int
  userId          Int
  createdAt       DateTime        @default(now())
  BusinessProfile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  Usuario         Usuario         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([profileId, userId])
  @@index([profileId])
  @@index([userId])
}

model BusinessProfile {
  id               Int                   @id @default(autoincrement())
  userId           Int                   @unique
  organizationId   Int
  visionId         Int?
  headline         String                @db.VarChar(100)
  categoryId       Int
  description      String
  discountOffer    String                @db.VarChar(200)
  city             String
  state            String
  coverageZone     String?
  whatsappPhone    String                @db.VarChar(20)
  email            String?
  website          String?
  galleryImages    String[]              @default([])
  logoUrl          String?
  avgRating        Float                 @default(0)
  totalReviews     Int                   @default(0)
  oneStarCount     Int                   @default(0)
  status           BusinessProfileStatus @default(PENDING)
  isVerified       Boolean               @default(false)
  isPLGraduate     Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime
  suspendedAt      DateTime?
  suspensionReason String?
  nudgeCount       Int                   @default(0)
  BusinessNudge    BusinessNudge[]
  BusinessCategory BusinessCategory      @relation(fields: [categoryId], references: [id])
  Organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Usuario          Usuario               @relation(fields: [userId], references: [id], onDelete: Cascade)
  Vision           Vision?               @relation(fields: [visionId], references: [id])
  ServiceReview    ServiceReview[]

  @@index([avgRating])
  @@index([categoryId])
  @@index([city, state])
  @@index([organizationId])
  @@index([status])
  @@index([visionId])
}

model CallAvailability {
  id        Int      @id @default(autoincrement())
  mentorId  Int
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  type      CallType @default(DISCIPLINE)
  Usuario   Usuario  @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([dayOfWeek])
  @@index([mentorId])
  @@index([type])
}

model CallBooking {
  id                                     Int                 @id @default(autoincrement())
  mentorId                               Int
  studentId                              Int
  scheduledAt                            DateTime
  duration                               Int                 @default(15)
  status                                 EstadoLlamada       @default(PENDING)
  notes                                  String?
  rating                                 Int?
  confirmedAt                            DateTime?
  completedAt                            DateTime?
  createdAt                              DateTime            @default(now())
  updatedAt                              DateTime            @default(now())
  meetingLink                            String?
  type                                   CallType            @default(DISCIPLINE)
  recurringGroupId                       String?
  programEnrollmentId                    Int?
  attendanceStatus                       String?             @default("PENDING")
  weekNumber                             Int?
  packageOrderId                         String?
  Usuario_CallBooking_mentorIdToUsuario  Usuario             @relation("CallBooking_mentorIdToUsuario", fields: [mentorId], references: [id], onDelete: Cascade)
  MentorPackageOrder                     MentorPackageOrder? @relation(fields: [packageOrderId], references: [id])
  ProgramEnrollment                      ProgramEnrollment?  @relation(fields: [programEnrollmentId], references: [id], onDelete: Cascade)
  Usuario_CallBooking_studentIdToUsuario Usuario             @relation("CallBooking_studentIdToUsuario", fields: [studentId], references: [id], onDelete: Cascade)
  PayableCall                            PayableCall[]
  Transaction                            Transaction?

  @@unique([mentorId, scheduledAt])
  @@index([attendanceStatus])
  @@index([mentorId])
  @@index([packageOrderId])
  @@index([programEnrollmentId])
  @@index([recurringGroupId])
  @@index([scheduledAt])
  @@index([status])
  @@index([studentId])
  @@index([type])
}

model CallInteractionLog {
  id                Int               @id @default(autoincrement())
  trackingId        Int
  coordinatorId     Int
  callResult        CallResult
  comments          String?
  createdAt         DateTime          @default(now())
  Usuario           Usuario           @relation(fields: [coordinatorId], references: [id])
  BasicCallTracking BasicCallTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)

  @@index([coordinatorId])
  @@index([createdAt])
  @@index([trackingId])
}

model CallLog {
  id                                 Int      @id @default(autoincrement())
  studentId                          Int
  mentorId                           Int
  subscriptionId                     Int?
  callDate                           DateTime
  dayOfWeek                          Int
  status                             String
  notes                              String?
  createdAt                          DateTime @default(now())
  Usuario_CallLog_mentorIdToUsuario  Usuario  @relation("CallLog_mentorIdToUsuario", fields: [mentorId], references: [id], onDelete: Cascade)
  Usuario_CallLog_studentIdToUsuario Usuario  @relation("CallLog_studentIdToUsuario", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([callDate])
  @@index([mentorId])
  @@index([status])
  @@index([studentId])
}

model CapsuleLineageNotification {
  id               Int       @id @default(autoincrement())
  campaignId       Int
  notifiedUserId   Int
  participantId    Int
  lineageLevel     Int
  notificationSent Boolean   @default(false)
  sentAt           DateTime?
  messageSent      Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@unique([campaignId, notifiedUserId, participantId])
  @@index([campaignId])
  @@index([notifiedUserId])
  @@index([participantId])
}

model CapsuleMessage {
  id                                           Int                 @id @default(autoincrement())
  campaignId                                   Int
  recipientId                                  Int
  senderName                                   String
  senderRelation                               String
  senderUserId                                 Int?
  senderEmail                                  String?
  messageType                                  CapsuleMessageType
  textContent                                  String?
  audioUrl                                     String?
  audioDuration                                Int?
  isUnlocked                                   Boolean             @default(false)
  isFavorite                                   Boolean             @default(false)
  isRead                                       Boolean             @default(false)
  pointsAwarded                                Boolean             @default(false)
  createdAt                                    DateTime            @default(now())
