}

model MentorApplication {
  id                                            Int               @id @default(autoincrement())
  usuarioId                                     Int               @unique
  status                                        ApplicationStatus @default(PENDING)
  titulo                                        String
  especialidad                                  String
  especialidadesSecundarias                     String[]          @default([])
  experienciaAnios                              Int
  biografiaCorta                                String?
  biografiaCompleta                             String
  tagline                                       String?
  promiseStatement                              String?
  methodologyStyle                              MentorStyle?      @default(BALANCED)
  idealClientDescription                        String?
  horarioInicio                                 String?           @default("09:00")
  horarioFin                                    String?           @default("18:00")
  diasDisponibles                               String[]          @default([])
  logros                                        String[]          @default([])
  expertiseTags                                 String[]          @default([])
  videoIntroUrl                                 String?
  paymentIntentId                               String?
  paymentStatus                                 String?           @default("PENDING")
  amountPaid                                    Float?
  reviewedBy                                    Int?
  reviewedAt                                    DateTime?
  rejectionReason                               String?
  createdAt                                     DateTime          @default(now())
  updatedAt                                     DateTime
  documentosUrls                                String[]          @default([])
  licenseCodeId                                 Int?
  paidAt                                        DateTime?
  paymentMethod                                 String?
  LicenseCode                                   LicenseCode?      @relation(fields: [licenseCodeId], references: [id])
  Usuario_MentorApplication_reviewedByToUsuario Usuario?          @relation("MentorApplication_reviewedByToUsuario", fields: [reviewedBy], references: [id])
  Usuario_MentorApplication_usuarioIdToUsuario  Usuario           @relation("MentorApplication_usuarioIdToUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
}

model MentorMembershipRenewal {
  id                    Int          @id @default(autoincrement())
  mentorId              Int
  renewalDate           DateTime
  expiryDate            DateTime
  amount                Float
  stripePaymentIntentId String?
