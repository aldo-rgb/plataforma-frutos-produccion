model MentorPayout {
  id             Int           @id @default(autoincrement())
  escrowId       Int
  mentorId       Int
  visionId       Int
  weekNumber     Int
  callsCompleted Int
  ratePerCall    Decimal       @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
