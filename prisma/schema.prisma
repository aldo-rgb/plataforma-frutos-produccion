model PricingConfig {
  id        Int      @id @default(autoincrement())
  plan      String   // 'free', 'standard', 'premium'
  currency  String   // 'MXN', 'USD'
  period    String?  // 'bimestral', 'anual' (null for free)
  price     Float    
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plan, currency, period])
}

// 🏦 TICKET 4: Organization Wallet - Billetera de la Organización
model OrganizationWallet {
  id                Int                      @id @default(autoincrement())
  organizationId    Int                      @unique
  balance           Decimal                  @default(0) @db.Decimal(10, 2)
  currency          String                   @default("MXN")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  
  Organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  WalletTransaction WalletTransaction[]

  @@index([organizationId])
}

// Historial de transacciones de la billetera
model WalletTransaction {
  id                 Int                @id @default(autoincrement())
  walletId           Int
  amount             Decimal            @db.Decimal(10, 2)
  type               WalletTxType       // CREDIT (entrada) o DEBIT (salida)
  source             String             // 'REFUND_DROPOUT', 'REFUND_VISION_CLOSE', 'PAYMENT_CYCLE', 'ADMIN_ADJUSTMENT'
  description        String
  visionId           Int?
  studentId          Int?
  relatedEntityId    Int?               // ID de la visión, pago, etc.
  createdAt          DateTime           @default(now())
  
  OrganizationWallet OrganizationWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([visionId])
  @@index([createdAt])
}

// 🧾 TICKET 1: Escrow - Bóveda de Dinero por Visión
model VisionEscrow {
  id                    Int              @id @default(autoincrement())
  visionId              Int              @unique
  totalDeposited        Decimal          @db.Decimal(10, 2) // Total depositado al inicio
  totalPaid             Decimal          @default(0) @db.Decimal(10, 2) // Total pagado a mentores
  remainingBalance      Decimal          @db.Decimal(10, 2) // Saldo restante
  status                EscrowStatus     @default(ACTIVE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  closedAt              DateTime?
  
  Vision                Vision           @relation(fields: [visionId], references: [id], onDelete: Cascade)
  MentorPayout          MentorPayout[]

  @@index([visionId])
  @@index([status])
}

// 🧾 TICKET 2: Pagos semanales a mentores
model MentorPayout {
  id                  Int              @id @default(autoincrement())
  escrowId            Int
  mentorId            Int
  visionId            Int
  weekNumber          Int              // Semana del ciclo (1-16)
  callsCompleted      Int              // Llamadas completadas/pagables
  ratePerCall         Decimal          @db.Decimal(10, 2) // Tarifa por llamada
  totalAmount         Decimal          @db.Decimal(10, 2) // Total a pagar
  status              PayoutStatus     @default(PENDING)
  generatedAt         DateTime         @default(now())
  paidAt              DateTime?
  paymentMethod       String?          // 'STRIPE', 'BANK_TRANSFER', 'MANUAL'
  transactionRef      String?          // Referencia de pago externo
  
  VisionEscrow        VisionEscrow     @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  Usuario             Usuario          @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  PayableCall         PayableCall[]

  @@index([escrowId])
  @@index([mentorId])
  @@index([visionId])
  @@index([weekNumber])
  @@index([status])
}

// Llamadas que cuentan para pago
model PayableCall {
  id               Int            @id @default(autoincrement())
  payoutId         Int
  callBookingId    Int
  mentorId         Int
  studentId        Int
  visionId         Int
  weekNumber       Int
  callDate         DateTime
  status           String         // 'COMPLETED', 'MISSED_BY_USER'
  rateApplied      Decimal        @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  
  MentorPayout     MentorPayout   @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  CallBooking      CallBooking    @relation(fields: [callBookingId], references: [id], onDelete: Cascade)

  @@index([payoutId])
  @@index([callBookingId])
  @@index([mentorId])
  @@index([visionId])
  @@index([weekNumber])
}

// 🐷 TICKET 3: Sistema de reembolsos por abandono
model VisionRefund {
  id                  Int              @id @default(autoincrement())
  visionId            Int
  escrowId            Int
  studentId           Int
  reason              RefundReason
  callsScheduled      Int              // Total de llamadas programadas
  callsCompleted      Int              // Llamadas ya completadas
  callsCancelled      Int              // Llamadas canceladas (huérfanas)
  amountRefunded      Decimal          @db.Decimal(10, 2)
  processedAt         DateTime         @default(now())
  droppedAt           DateTime?        // Cuando el alumno fue dado de baja
  
  @@index([visionId])
  @@index([escrowId])
  @@index([studentId])
}

// Enums para los nuevos modelos
enum WalletTxType {
  CREDIT  // Entrada de dinero
  DEBIT   // Salida de dinero
}

enum EscrowStatus {
  ACTIVE    // Ciclo en curso
  CLOSED    // Ciclo terminado y auditado
  CANCELLED // Ciclo cancelado
}

enum PayoutStatus {
  PENDING     // Esperando generación de reporte
  GENERATED   // Reporte generado, listo para pago
  PAID        // Pagado al mentor
  FAILED      // Fallo en el pago
  DISPUTED    // En disputa
}

enum RefundReason {
  STUDENT_DROPOUT        // Alumno abandonó
  VISION_CANCELLED       // Visión cancelada
  ADMIN_ADJUSTMENT       // Ajuste administrativo
  MENTOR_UNAVAILABLE     // Mentor no disponible
}

// 💼 Sistema de Paquetes de Mentoría para Participantes
model MentorPackageOrder {
  id                  String                @id @default(cuid())
  usuarioId           Int                   // Participante que compra
  mentorId            Int                   // Mentor seleccionado
  visionId            Int                   // Visión asociada
  organizationId      Int?                  // Organización si aplica
  cantidad            Int                   // Número de sesiones (18)
  precioUnitario      Int                   // Precio por sesión
  precioTotal         Int                   // Precio total del paquete
  currency            String                @default("MXN")
  metodoPago          String                // 'stripe', 'paypal', 'mercadopago'
  status              PackageOrderStatus    @default(PENDING)
  externalPaymentId   String?               // ID del pago en la pasarela
  paymentUrl          String?               // URL de checkout
  paidAt              DateTime?             // Fecha de pago exitoso
  paymentData         Json?                 // Datos adicionales del pago
  sessionScheduled    Boolean               @default(false) // Si ya se agendaron las sesiones
  sessionsScheduledAt DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  
  Usuario             Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  Mentor              Usuario               @relation("MentorPackages", fields: [mentorId], references: [id], onDelete: Cascade)
  Vision              Vision                @relation(fields: [visionId], references: [id], onDelete: Cascade)
  Organization        Organization?         @relation(fields: [organizationId], references: [id])
  CallBooking         CallBooking[]         // 📦 Sesiones agendadas del paquete
  PackageSessionCredits PackageSessionCredits? // 💳 Balance de créditos

  @@index([usuarioId])
  @@index([mentorId])
  @@index([visionId])
  @@index([status])
  @@index([externalPaymentId])
}

// 💳 Sistema de Créditos de Sesiones por Paquete
model PackageSessionCredits {
  id              String             @id @default(cuid())
  packageOrderId  String             @unique // Relación 1:1 con paquete
  totalSessions   Int                // Total de sesiones compradas (18)
  usedSessions    Int                @default(0) // Sesiones consumidas
  remainingSessions Int              // Sesiones disponibles (calculado)
  expiresAt       DateTime?          // Fecha de expiración (opcional)
  isActive        Boolean            @default(true) // Si el paquete está activo
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  MentorPackageOrder MentorPackageOrder @relation(fields: [packageOrderId], references: [id], onDelete: Cascade)

  @@index([packageOrderId])
  @@index([isActive])
  @@index([expiresAt])
}

enum PackageOrderStatus {
  PENDING           // Orden creada, esperando pago
  PROCESSING        // Procesando pago
  COMPLETED         // Pago exitoso, paquete activado
  FAILED            // Pago fallido
  CANCELLED         // Orden cancelada
  REFUNDED          // Reembolsado
}

// 💰 SISTEMA DE COMISIONES - Commission Ledger
// Registro inmutable de pagos a mentores por servicios completados
model CommissionLedger {
  id               String           @id @default(cuid())
  mentorId         Int              // Quien recibe el dinero
  sourceType       CommissionSource // Tipo de servicio
  sourceId         Int              // ID de la sesión/llamada
  studentId        Int              // Cliente que pagó
  studentName      String           // Nombre del cliente (snapshot)
  totalAmount      Decimal          @db.Decimal(10, 2) // Lo que pagó el cliente
  platformFee      Decimal          @db.Decimal(10, 2) // % que se queda Quantum
  platformPercent  Int              // Porcentaje congelado al momento
  payableAmount    Decimal          @db.Decimal(10, 2) // Lo que se paga al mentor
  currency         String           @default("MXN")
  status           CommissionStatus @default(PENDING)
  serviceName      String?          // Descripción del servicio
  scheduledAt      DateTime         // Fecha original del servicio
  completedAt      DateTime         @default(now()) // Fecha de completado
  paidAt           DateTime?        // Fecha de pago real al mentor
  payoutBatchId    String?          // ID del lote de pago bancario
  paymentMethod    String?          // stripe, paypal, transfer
  paymentReference String?          // Referencia bancaria/transaction ID
  notes            String?          // Notas administrativas
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  Mentor           Usuario          @relation("CommissionMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  Student          Usuario          @relation("CommissionStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([studentId])
  @@index([sourceType])
  @@index([sourceId])
  @@index([status])
  @@index([completedAt])
  @@index([paidAt])
  @@index([payoutBatchId])
}

model MentorApplication {
  id                       Int                    @id @default(autoincrement())
  usuarioId                Int                    @unique
  status                   ApplicationStatus      @default(PENDING)
  
  // Información Básica
  titulo                   String
  especialidad             String
  especialidadesSecundarias String[]              @default([])
  experienciaAnios         Int
  
  // Biografías
  biografiaCorta           String?
  biografiaCompleta        String
  
  // Metodología y Enfoque
  tagline                  String?
  promiseStatement         String?
  methodologyStyle         MentorStyle?          @default(BALANCED)
  idealClientDescription   String?
  
  // Disponibilidad
  horarioInicio            String?               @default("09:00")
  horarioFin               String?               @default("18:00")
  diasDisponibles          String[]              @default([])
  
  // Experiencia y Logros
  logros                   String[]              @default([])
  expertiseTags            String[]              @default([])
  
  // Video de presentación
  videoIntroUrl            String?
  
  // Documentos de soporte
  documentosUrls           String[]              @default([])
  
  // Pago
  paymentIntentId          String?
  paymentStatus            String?               @default("PENDING")
  amountPaid               Float?
  
  // Revisión
  reviewedBy               Int?
  reviewedAt               DateTime?
  rejectionReason          String?
  
  // Timestamps
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  
  Usuario                  Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ReviewedByUser           Usuario?              @relation("ApplicationReviewer", fields: [reviewedBy], references: [id])
}

enum ApplicationStatus {
  DRAFT      // Borrador (no pagado)
  PENDING    // Pendiente de revisión (pagado)
  APPROVED   // Aprobado - usuario convertido a mentor
  REJECTED   // Rechazado
}

enum CommissionSource {
  MENTORSHIP_SESSION // Sesión 1:1 de mentoría
  DISCIPLINE_CALL    // Llamada de disciplina (15 min)
  PACKAGE_SESSION    // Sesión dentro de paquete de 18
}

enum CommissionStatus {
  PENDING    // Por pagar
  PAID       // Pagado al mentor
  CANCELLED  // Cancelado (sesión no realizada)
  DISPUTED   // En disputa
  REFUNDED   // Reembolsado
}

model MentorMembershipRenewal {
  id                    Int          @id @default(autoincrement())
  mentorId              Int
  renewalDate           DateTime
  expiryDate            DateTime
  amount                Float
  stripePaymentIntentId String?
  status                String       @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  autoRenewed           Boolean      @default(false)
  createdAt             DateTime     @default(now())
  
  PerfilMentor          PerfilMentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  
  @@index([mentorId])
  @@index([expiryDate])
  @@index([status])
}

// 💰 Sistema de Pagos Semanales a Mentores
model WeeklyPayrollPeriod {
  id                Int                    @id @default(autoincrement())
  weekStartDate     DateTime               // Lunes 00:00
  weekEndDate       DateTime               // Domingo 23:59
  status            PayrollStatus          @default(PENDING)
  totalAmount       Decimal                @default(0) @db.Decimal(10, 2)
  totalCalls        Int                    @default(0)
  processedAt       DateTime?
  processedBy       Int?
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  
  MentorPayrollItem MentorPayrollItem[]
  
  @@index([weekStartDate])
  @@index([status])
}

model MentorPayrollItem {
  id              Int                  @id @default(autoincrement())
  payrollPeriodId Int
  mentorId        Int
  callsCompleted  Int                  @default(0)
  callsMissedByUser Int                @default(0) // Mentor estuvo, alumno faltó (SE COBRA)
  ratePerCall     Decimal              @db.Decimal(10, 2)
  totalAmount     Decimal              @db.Decimal(10, 2)
  status          PayrollItemStatus    @default(PENDING)
  paidAt          DateTime?
  paymentMethod   String?              // 'TRANSFER', 'STRIPE_CONNECT', 'CASH'
  paymentReference String?             // Número de transferencia, etc.
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  PayrollPeriod   WeeklyPayrollPeriod  @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  Mentor          Usuario              @relation("MentorPayrollItems", fields: [mentorId], references: [id], onDelete: Cascade)
  
  @@index([payrollPeriodId])
  @@index([mentorId])
  @@index([status])
}

// 💸 Reembolsos por deserción de estudiantes
model RefundRequest {
  id              Int              @id @default(autoincrement())
  organizationId  Int
  visionId        Int
  studentId       Int
  requestedBy     Int
  studentName     String
  dropoutWeek     Int              // Semana en la que desertó
  totalCallsPaid  Int              // Total de llamadas pagadas
  callsCompleted  Int              // Llamadas que sí se hicieron
  callsToRefund   Int              // Llamadas a reembolsar
  amountPaid      Decimal          @db.Decimal(10, 2)
  amountToRefund  Decimal          @db.Decimal(10, 2)
  status          RefundStatus     @default(PENDING)
  processedAt     DateTime?
  processedBy     Int?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  Organization    Organization     @relation("RefundRequestOrganization", fields: [organizationId], references: [id])
  Vision          Vision           @relation("RefundRequestVision", fields: [visionId], references: [id])
  Student         Usuario          @relation("RefundRequestStudent", fields: [studentId], references: [id])
  RequestedBy     Usuario          @relation("RefundRequestRequestedBy", fields: [requestedBy], references: [id])
  ProcessedBy     Usuario?         @relation("RefundRequestProcessedBy", fields: [processedBy], references: [id])
  
  @@index([organizationId])
  @@index([visionId])
  @@index([status])
}

enum PayrollStatus {
  PENDING    // En espera de procesamiento
  PROCESSING // Procesando pagos
  COMPLETED  // Completado
  CANCELLED  // Cancelado
}

enum PayrollItemStatus {
  PENDING    // Por pagar
  PAID       // Pagado
  CANCELLED  // Cancelado
  DISPUTED   // En disputa
}

enum RefundStatus {
  PENDING    // Pendiente de aprobación
  APPROVED   // Aprobado, procesando
  COMPLETED  // Reembolsado a wallet
  REJECTED   // Rechazado
  CANCELLED  // Cancelado
}

enum ProfileApprovalStatus {
  DRAFT       // Borrador, no enviado
  PENDING     // En revisión
  APPROVED    // Aprobado
  REJECTED    // Rechazado
}
