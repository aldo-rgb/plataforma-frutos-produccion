generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Accion {
  id                Int               @id @default(autoincrement())
  metaId            Int
  texto             String
  diasProgramados   String?
  completada        Boolean           @default(false)
  enRevision        Boolean           @default(false)
  requiereEvidencia Boolean           @default(true)
  lastCompletedDate DateTime?
  frequency         String?
  assignedDays      Int[]
  specificDate      DateTime?
  rarity            TaskRarity        @default(COMMON)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  Meta              Meta              @relation(fields: [metaId], references: [id], onDelete: Cascade)
  EvidenciaAccion   EvidenciaAccion[]
  TaskInstance      TaskInstance[]
}

model AdminTask {
  id                Int              @id @default(autoincrement())
  type              AdminTaskType
  titulo            String
  descripcion       String?
  pointsReward      Int              @default(0)
  targetType        TargetType
  targetId          Int?
  fechaLimite       DateTime?        @db.Date
  fechaEvento       DateTime?
  horaEvento        String?
  lugar             String?
  requiereEvidencia Boolean          @default(false)
  isActive          Boolean          @default(true)
  createdBy         Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  rewardLogic       RewardLogic      @default(STANDARD)
  raceLimit         Int?
  strictDeadline    Boolean          @default(false)
  diaNumero         Int?
  duracionDias      Int?
  horaLimiteDiaria  String?
  isMultiDay        Boolean          @default(false)
  parentTaskId      Int?
  Usuario           Usuario          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  AdminTask         AdminTask?       @relation("AdminTaskToAdminTask", fields: [parentTaskId], references: [id], onDelete: Cascade)
  other_AdminTask   AdminTask[]      @relation("AdminTaskToAdminTask")
  TaskSubmission    TaskSubmission[]

  @@index([fechaLimite])
  @@index([isActive])
  @@index([isMultiDay])
  @@index([parentTaskId])
  @@index([rewardLogic])
  @@index([targetType])
  @@index([type])
}

model AreaConfig {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  areaKey   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, areaKey])
  @@index([usuarioId])
}

model ArenaDailyUpdate {
  id            Int       @id @default(autoincrement())
  duelId        Int
  date          DateTime  @db.Date
  player1HP     Int
  player2HP     Int
  player1Damage Int       @default(0)
  player2Damage Int       @default(0)
  player1Failed Boolean   @default(false)
  player2Failed Boolean   @default(false)
  narration     String?
  createdAt     DateTime  @default(now())
  ArenaDuel     ArenaDuel @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, date])
  @@index([duelId])
}

model ArenaDuel {
  id                                   Int                @id @default(autoincrement())
  player1Id                            Int
  player2Id                            Int
  status                               DuelStatus         @default(MATCHING)
  betAmount                            Int                @default(500)
  escrowTotal                          Int                @default(1000)
  startDate                            DateTime           @db.Date
  endDate                              DateTime           @db.Date
  player1HP                            Int                @default(100)
  player2HP                            Int                @default(100)
  player1Completion                    Float              @default(0)
  player2Completion                    Float              @default(0)
  winnerId                             Int?
  prize                                Int?
  resolvedAt                           DateTime?
  resolutionType                       ResolutionType?
  createdAt                            DateTime           @default(now())
  updatedAt                            DateTime
  ArenaDailyUpdate                     ArenaDailyUpdate[]
  Usuario_ArenaDuel_player1IdToUsuario Usuario            @relation("ArenaDuel_player1IdToUsuario", fields: [player1Id], references: [id], onDelete: Cascade)
  Usuario_ArenaDuel_player2IdToUsuario Usuario            @relation("ArenaDuel_player2IdToUsuario", fields: [player2Id], references: [id], onDelete: Cascade)
  Usuario_ArenaDuel_winnerIdToUsuario  Usuario?           @relation("ArenaDuel_winnerIdToUsuario", fields: [winnerId], references: [id])
  ArenaTaunt                           ArenaTaunt[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([startDate, endDate])
  @@index([status])
}

model ArenaQueue {
  id        Int         @id @default(autoincrement())
  usuarioId Int         @unique
  userLevel String
  timezone  String      @default("America/Mexico_City")
  pcBalance Int
  status    QueueStatus @default(SEARCHING)
  enteredAt DateTime    @default(now())
  expiresAt DateTime
  Usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([status, userLevel])
}

model ArenaStats {
  id            Int       @id @default(autoincrement())
  usuarioId     Int       @unique
  totalDuels    Int       @default(0)
  wins          Int       @default(0)
  losses        Int       @default(0)
  ties          Int       @default(0)
  totalWagered  Int       @default(0)
  totalWon      Int       @default(0)
  totalLost     Int       @default(0)
  netProfit     Int       @default(0)
  currentStreak Int       @default(0)
  bestStreak    Int       @default(0)
  badges        String[]  @default([])
  lastDuelAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model ArenaTaunt {
  id                                     Int       @id @default(autoincrement())
  duelId                                 Int
  senderId                               Int
  receiverId                             Int
  tauntType                              TauntType
  customMessage                          String?
  read                                   Boolean   @default(false)
  createdAt                              DateTime  @default(now())
  ArenaDuel                              ArenaDuel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  Usuario_ArenaTaunt_receiverIdToUsuario Usuario   @relation("ArenaTaunt_receiverIdToUsuario", fields: [receiverId], references: [id], onDelete: Cascade)
  Usuario_ArenaTaunt_senderIdToUsuario   Usuario   @relation("ArenaTaunt_senderIdToUsuario", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([duelId])
  @@index([receiverId, read])
}

model AvatarGenerationAttempt {
  id           Int      @id @default(autoincrement())
  usuarioId    Int
  sourceImage  String
  generatedUrl String
  vibe         String   @default("cyberpunk")
  gender       String
  createdAt    DateTime @default(now())
  Usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([usuarioId])
}

model CallAvailability {
  id        Int      @id @default(autoincrement())
  mentorId  Int
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  type      CallType @default(DISCIPLINE)
  Usuario   Usuario  @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([dayOfWeek])
  @@index([mentorId])
  @@index([type])
}

model CallBooking {
  id                                     Int                @id @default(autoincrement())
  mentorId                               Int
  studentId                              Int
  scheduledAt                            DateTime
  duration                               Int                @default(15)
  status                                 EstadoLlamada      @default(PENDING)
  notes                                  String?
  rating                                 Int?
  confirmedAt                            DateTime?
  completedAt                            DateTime?
  createdAt                              DateTime           @default(now())
  updatedAt                              DateTime           @default(now())
  meetingLink                            String?
  type                                   CallType           @default(DISCIPLINE)
  recurringGroupId                       String?
  programEnrollmentId                    Int?
  attendanceStatus                       String?            @default("PENDING")
  weekNumber                             Int?
  packageOrderId                         String?            // 📦 Si pertenece a un paquete
  Usuario_CallBooking_mentorIdToUsuario  Usuario            @relation("CallBooking_mentorIdToUsuario", fields: [mentorId], references: [id], onDelete: Cascade)
  ProgramEnrollment                      ProgramEnrollment? @relation(fields: [programEnrollmentId], references: [id], onDelete: Cascade)
  Usuario_CallBooking_studentIdToUsuario Usuario            @relation("CallBooking_studentIdToUsuario", fields: [studentId], references: [id], onDelete: Cascade)
  MentorPackageOrder                     MentorPackageOrder? @relation(fields: [packageOrderId], references: [id], onDelete: SetNull)
  Transaction                            Transaction?
  PayableCall                            PayableCall[]

  @@unique([mentorId, scheduledAt])
  @@index([attendanceStatus])
  @@index([mentorId])
  @@index([packageOrderId])
  @@index([programEnrollmentId])
  @@index([recurringGroupId])
  @@index([scheduledAt])
  @@index([status])
  @@index([studentId])
  @@index([type])
}

model CallLog {
  id                                 Int      @id @default(autoincrement())
  studentId                          Int
  mentorId                           Int
  subscriptionId                     Int?
  callDate                           DateTime
  dayOfWeek                          Int
  status                             String
  notes                              String?
  createdAt                          DateTime @default(now())
  Usuario_CallLog_mentorIdToUsuario  Usuario  @relation("CallLog_mentorIdToUsuario", fields: [mentorId], references: [id], onDelete: Cascade)
  Usuario_CallLog_studentIdToUsuario Usuario  @relation("CallLog_studentIdToUsuario", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([callDate])
  @@index([mentorId])
  @@index([status])
  @@index([studentId])
}

model CartaFrutos {
  id                               Int         @id @default(autoincrement())
  usuarioId                        Int
  finanzasMeta                     String?
  finanzasAvance                   Int         @default(0)
  finanzasScheduledDays            String?
  relacionesMeta                   String?
  relacionesAvance                 Int         @default(0)
  relacionesScheduledDays          String?
  talentosMeta                     String?
  talentosAvance                   Int         @default(0)
  talentosScheduledDays            String?
  pazMentalMeta                    String?
  pazMentalAvance                  Int         @default(0)
  pazMentalScheduledDays           String?
  ocioMeta                         String?
  ocioAvance                       Int         @default(0)
  ocioScheduledDays                String?
  saludMeta                        String?
  saludAvance                      Int         @default(0)
  saludScheduledDays               String?
  servicioTransMeta                String?
  servicioTransAvance              Int         @default(0)
  servicioTransScheduledDays       String?
  servicioComunMeta                String?
  servicioComunAvance              Int         @default(0)
  servicioComunScheduledDays       String?
  enrolamientoMeta                 String?     @default("Invitar a 4 personas")
  enrolamientoAvance               Int         @default(0)
  invitadosInscritos               Int         @default(0)
  estado                           EstadoCarta @default(BORRADOR)
  autorizadoMentor                 Boolean     @default(false)
  autorizadoCoord                  Boolean     @default(false)
  autorizadoPorId                  Int?
  approvedAt                       DateTime?
  fechaActualizacion               DateTime
  fechaCreacion                    DateTime    @default(now())
  finanzasDeclaracion              String?
  finanzasDeclaracionStatus        EstadoItem  @default(PENDING)
  finanzasDeclaracionFeedback      String?
  ocioDeclaracion                  String?
  ocioDeclaracionStatus            EstadoItem  @default(PENDING)
  ocioDeclaracionFeedback          String?
  pazMentalDeclaracion             String?
  pazMentalDeclaracionStatus       EstadoItem  @default(PENDING)
  pazMentalDeclaracionFeedback     String?
  relacionesDeclaracion            String?
  relacionesDeclaracionStatus      EstadoItem  @default(PENDING)
  relacionesDeclaracionFeedback    String?
  saludDeclaracion                 String?
  saludDeclaracionStatus           EstadoItem  @default(PENDING)
  saludDeclaracionFeedback         String?
  servicioComunDeclaracion         String?
  servicioComunDeclaracionStatus   EstadoItem  @default(PENDING)
  servicioComunDeclaracionFeedback String?
  servicioTransDeclaracion         String?
  servicioTransDeclaracionStatus   EstadoItem  @default(PENDING)
  servicioTransDeclaracionFeedback String?
  talentosDeclaracion              String?
  talentosDeclaracionStatus        EstadoItem  @default(PENDING)
  talentosDeclaracionFeedback      String?
  feedbackMentor                   String?
  Usuario                          Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  Meta                             Meta[]
  Tarea                            Tarea[]
}

model CheckIn {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  locationId    Int
  checkInMethod String
  latitude      Float
  longitude     Float
  distance      Float
  xpGranted     Int      @default(50)
  createdAt     DateTime @default(now())
  Location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  Usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, locationId, createdAt])
  @@index([createdAt])
  @@index([locationId])
  @@index([usuarioId])
}

model Collection {
  id                     Int                      @id @default(autoincrement())
  name                   String
  description            String
  type                   CollectionType
  requiredCount          Int                      @default(7)
  rewardPC               Int                      @default(300)
  rewardBadge            String
  iconUrl                String?
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  UserCollectionProgress UserCollectionProgress[]
}

model DisciplineConfig {
  id          Int      @id @default(autoincrement())
  mentorId    Int      @unique
  allowedDays Int[]
  startHour   String
  endHour     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Usuario     Usuario  @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
}

model DisciplineSchedule {
  id          Int      @id @default(autoincrement())
  mentorId    Int      @unique
  allowedDays Int[]
  startTime   String   @default("05:00")
  endTime     String   @default("08:00")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Usuario     Usuario  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
}

model DisciplineSubscription {
  id                                                Int      @id @default(autoincrement())
  studentId                                         Int      @unique
  mentorId                                          Int
  day1                                              Int
  time1                                             String
  day2                                              Int
  time2                                             String
  startDate                                         DateTime @default(now())
  endDate                                           DateTime
  status                                            String   @default("ACTIVE")
  missedCallsCount                                  Int      @default(0)
  createdAt                                         DateTime @default(now())
  updatedAt                                         DateTime
  Usuario_DisciplineSubscription_mentorIdToUsuario  Usuario  @relation("DisciplineSubscription_mentorIdToUsuario", fields: [mentorId], references: [id], onDelete: Cascade)
  Usuario_DisciplineSubscription_studentIdToUsuario Usuario  @relation("DisciplineSubscription_studentIdToUsuario", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([mentorId, day1, time1])
  @@index([mentorId, day2, time2])
  @@index([mentorId])
  @@index([status])
}

model DisponibilidadSemanal {
  id             Int          @id @default(autoincrement())
  perfilMentorId Int
  diaSemana      Int
  horaInicio     String
  horaFin        String
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  PerfilMentor   PerfilMentor @relation(fields: [perfilMentorId], references: [id], onDelete: Cascade)

  @@index([activo])
  @@index([diaSemana])
  @@index([perfilMentorId])
}

model Evidencia {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  titulo      String
  descripcion String?
  urlArchivo  String?
  semana      Int
  completado  Boolean  @default(false)
  validada    Boolean  @default(false)
  createdAt   DateTime @default(now())
  Usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model EvidenciaAccion {
  id                       Int              @id @default(autoincrement())
  usuarioId                Int
  metaId                   Int?
  accionId                 Int
  fechaSubida              DateTime         @default(now())
  fotoUrl                  String
  descripcion              String?
  estado                   EstadoEvidencia  @default(PENDIENTE)
  comentarioMentor         String?
  revisadoPorId            Int?
  fechaRevision            DateTime?
  highQuality              Boolean          @default(false)
  qualityScore             Int?
  rarityBonus              Boolean          @default(false)
  sharedCount              Int              @default(0)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime
  intentosCorreccion       Int              @default(0)
  puntosGenerados          Int              @default(0)
  rechazadaDefinitivamente Boolean          @default(false)
  tipoRechazo              TipoRechazo?
  Accion                   Accion           @relation(fields: [accionId], references: [id], onDelete: Cascade)
  Meta                     Meta?            @relation(fields: [metaId], references: [id])
  Usuario                  Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  SocialReaction           SocialReaction[]
  TaskInstance             TaskInstance[]
}

model ExcepcionDisponibilidad {
  id             Int          @id @default(autoincrement())
  perfilMentorId Int
  fechaInicio    DateTime
  fechaFin       DateTime
  motivo         String
  descripcion    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  PerfilMentor   PerfilMentor @relation(fields: [perfilMentorId], references: [id], onDelete: Cascade)

  @@index([fechaFin])
  @@index([fechaInicio])
  @@index([perfilMentorId])
}

model License {
  id               Int           @id @default(autoincrement())
  code             String        @unique
  tierAssigned     UserTier      @default(STANDARD)
  maxUses          Int           @default(100)
  usedCount        Int           @default(0)
  expiresAt        DateTime?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  autoAssignVision String?
  batchName        String?
  isMasterCode     Boolean       @default(false)
  organizationId   Int?
  generatedBy      Int?
  generationMode   String?       @default("INDIVIDUAL")
  isRevoked        Boolean       @default(false)
  revokedAt        DateTime?
  revokedBy        Int?
  studentName      String?
  Organization     Organization? @relation(fields: [organizationId], references: [id])

  @@index([code])
  @@index([organizationId])
}

model LicenseAssignment {
  id                                            Int          @id @default(autoincrement())
  userId                                        Int
  organizationId                                Int
  visionId                                      Int?
  licenseCode                                   String
  assignedBy                                    Int
  assignedAt                                    DateTime     @default(now())
  isActive                                      Boolean      @default(true)
  notes                                         String?
  activatedAt                                   DateTime?
  expiresAt                                     DateTime?
  Usuario_LicenseAssignment_assignedByToUsuario Usuario      @relation("LicenseAssignment_assignedByToUsuario", fields: [assignedBy], references: [id])
  Organization                                  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Usuario_LicenseAssignment_userIdToUsuario     Usuario      @relation("LicenseAssignment_userIdToUsuario", fields: [userId], references: [id], onDelete: Cascade)
  Vision                                        Vision?      @relation(fields: [visionId], references: [id])

  @@index([licenseCode])
  @@index([organizationId])
  @@index([userId])
  @@index([visionId])
}

model LicenseOrder {
  id                 String             @id
  organizationId     Int
  requestedBy        Int
  quantity           Int
  tier               UserTier           @default(STANDARD)
  amount             Float
  paymentMethod      String
  status             LicenseOrderStatus @default(PENDING)
  externalPaymentId  String?
  paymentUrl         String?
  paidAt             DateTime?
  paymentData        Json?
  creditsGenerated   Boolean            @default(false)
  creditsGeneratedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  Organization       Organization       @relation(fields: [organizationId], references: [id])
  Usuario            Usuario            @relation(fields: [requestedBy], references: [id])

  @@index([externalPaymentId])
  @@index([organizationId])
  @@index([status])
}

model Location {
  id                      Int                       @id @default(autoincrement())
  name                    String
  description             String?
  latitude                Float
  longitude               Float
  radiusMeter             Int                       @default(50)
  nfcTagId                String?                   @unique
  qrCodeHash              String                    @unique
  qrRotationDate          DateTime                  @default(now())
  isActive                Boolean                   @default(true)
  address                 String?
  city                    String?
  country                 String                    @default("México")
  imageUrl                String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  CheckIn                 CheckIn[]
  UserServiceContribution UserServiceContribution[]

  @@index([isActive])
  @@index([nfcTagId])
  @@index([qrCodeHash])
}

model MensajeChat {
  id        Int      @id @default(autoincrement())
  role      String
  contenido String
  usuarioId Int
  fecha     DateTime @default(now())
  Usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model MentorAbsenceReport {
  id                                              Int                 @id @default(autoincrement())
  studentId                                       Int
  mentorId                                        Int
  subscriptionId                                  Int?
  callBookingId                                   Int?
  reportedAt                                      DateTime            @default(now())
  scheduledTime                                   DateTime
  reason                                          String?
  status                                          AbsenceReportStatus @default(PENDING)
  reviewedBy                                      Int?
  reviewedAt                                      DateTime?
  reviewNotes                                     String?
  Usuario_MentorAbsenceReport_mentorIdToUsuario   Usuario             @relation("MentorAbsenceReport_mentorIdToUsuario", fields: [mentorId], references: [id], onDelete: Cascade)
  Usuario_MentorAbsenceReport_reviewedByToUsuario Usuario?            @relation("MentorAbsenceReport_reviewedByToUsuario", fields: [reviewedBy], references: [id])
  Usuario_MentorAbsenceReport_studentIdToUsuario  Usuario             @relation("MentorAbsenceReport_studentIdToUsuario", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([reportedAt])
  @@index([status])
  @@index([studentId])
}

model MentorAlert {
  id                                     Int           @id @default(autoincrement())
  mentorId                               Int
  usuarioId                              Int
  taskInstanceId                         Int?
  type                                   AlertType     @default(RISK_ALERT)
  message                                String
  read                                   Boolean       @default(false)
  createdAt                              DateTime      @default(now())
  Usuario_MentorAlert_mentorIdToUsuario  Usuario       @relation("MentorAlert_mentorIdToUsuario", fields: [mentorId], references: [id], onDelete: Cascade)
  TaskInstance                           TaskInstance? @relation(fields: [taskInstanceId], references: [id])
  Usuario_MentorAlert_usuarioIdToUsuario Usuario       @relation("MentorAlert_usuarioIdToUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([mentorId, read])
  @@index([usuarioId])
}

model Meta {
  id               Int               @id @default(autoincrement())
  cartaId          Int
  categoria        String
  orden            Int               @default(1)
  declaracionPoder String?
  metaPrincipal    String
  avance           Int               @default(0)
  status           EstadoItem        @default(PENDING)
  mentorFeedback   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  Accion           Accion[]
  EvidenciaAccion  EvidenciaAccion[]
  CartaFrutos      CartaFrutos       @relation(fields: [cartaId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  relatedId Int?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  Usuario   Usuario          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, isRead])
}

model Organization {
  id                                                    Int                  @id @default(autoincrement())
  name                                                  String
  slug                                                  String              @unique
  logoUrl                                               String?
  brandColor                                            String              @default("#6366F1")
  contactEmail                                          String
  status                                                OrganizationStatus  @default(ACTIVE)
  isGeofenced                                           Boolean             @default(false)
  campusLatitude                                        Float?
  campusLongitude                                       Float?
  geofenceRadius                                        Int                 @default(100)
