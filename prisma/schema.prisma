  Organization                  Organization?                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  VisionCommissionConfig        VisionCommissionConfig?
  VisionEscrow                  VisionEscrow?
  VisionGameChanger             VisionGameChanger[]
  VisionMentor                  VisionMentor[]
