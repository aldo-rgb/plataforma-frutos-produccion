  autoRenewed           Boolean      @default(false)
  createdAt             DateTime     @default(now())
  PerfilMentor          PerfilMentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([expiryDate])
  @@index([mentorId])
  @@index([status])
}

model MentorPackageOrder {
  id                                            String                 @id
  usuarioId                                     Int
  mentorId                                      Int
  visionId                                      Int
  organizationId                                Int?
  cantidad                                      Int
  precioUnitario                                Int
  precioTotal                                   Int
  currency                                      String                 @default("MXN")
  metodoPago                                    String
  status                                        PackageOrderStatus     @default(PENDING)
  externalPaymentId                             String?
  paymentUrl                                    String?
  paidAt                                        DateTime?
  paymentData                                   Json?
  sessionScheduled                              Boolean                @default(false)
  sessionsScheduledAt                           DateTime?
  createdAt                                     DateTime               @default(now())
  updatedAt                                     DateTime
  CallBooking                                   CallBooking[]
