  forceOcioArea                 Boolean                        @default(true)
  forcePazMentalArea            Boolean                        @default(true)
  forceRelacionesArea           Boolean                        @default(true)
  forceSaludArea                Boolean                        @default(true)
  forceTalentosArea             Boolean                        @default(true)
  enabledLevels                 VisionLevel[]                  @default([PL])
  financialConfigId             String?
  platformFeePercent            Float                          @default(0)
  CashBatches                   CashBatch[]                    @relation("CashBatchVision")
  CheckInRecord                 CheckInRecord[]
  Expenses                      Expense[]                      @relation("ExpenseVision")
