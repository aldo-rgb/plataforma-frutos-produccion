# Database URL - PostgreSQL (Neon)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# OpenAI API Key para el Mentor IA
OPENAI_API_KEY="sk-proj-..."

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here-min-32-characters"

# ============================================================================
# WHATSAPP BUSINESS API - Onboarding Automation
# ============================================================================

# Meta Cloud API (WhatsApp Business)
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_API_VERSION="v18.0"

# Plantillas de WhatsApp (deben estar aprobadas en Meta Business Manager):
# - vision_welcome_template: Mensaje para usuarios importados por visión
# - vision_magiclink_template: Magic link para usuarios importados
# - organic_welcome_template: Mensaje para registros orgánicos

# ============================================================================
# EMAIL CONFIGURATION - Resend API
# ============================================================================

# Resend API (para envío de correos de onboarding)
RESEND_API_KEY="re_123456789_your_key_here"
EMAIL_FROM="noreply@tudominio.com"

# Nota: Resend permite 3,000 emails gratis al mes
# Registrarse en: https://resend.com

# ============================================================================
# CRON JOBS SECURITY
# ============================================================================

# Secret para proteger endpoints de cron jobs
CRON_SECRET="your-random-secret-key-here-min-32-chars"

# ============================================================================
# PAYMENT GATEWAYS - Sistema de Licencias B2B
# ============================================================================

# PayPal
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_SECRET="your-paypal-secret"
PAYPAL_MODE="sandbox" # sandbox o production

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-..."

# Default password
DEFAULT_USER_PASSWORD="Quantum123."

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================

# Sentry - Error Tracking (https://sentry.io)
# Create a project at sentry.io and get your DSN
SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"

# Sentry Organization & Project (for source maps upload)
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="plataforma-frutos"
SENTRY_AUTH_TOKEN="sntrys_..."

# Vercel Analytics - Automatically enabled when deployed to Vercel
# No configuration needed - works out of the box
